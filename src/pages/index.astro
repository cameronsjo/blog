---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pip from '../components/Pip.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { withBase } from '../utils';

// Astro's collection order is non-deterministic — sort explicitly, newest first.
const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
// Landing shows the latest N; the full set lives in the paginated archive.
const LATEST = 10;
const posts = allPosts.slice(0, LATEST);
const hasMore = allPosts.length > LATEST;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  {/* A terminal-style welcome panel: accent frame with the title set into its
      top border, Pip on the left, the tagline beside it. */}
  <div class="welcome pip-host reveal" style="--i: 0">
    <p class="welcome__legend">{SITE_TITLE}</p>
    <Pip />
    <h1 class="welcome__title">{SITE_DESCRIPTION}</h1>
  </div>
  {
    posts.length > 0 ? (
      <ol class="entries" role="list">
        {posts.map((post, i) => (
          <li class="reveal" style={`--i: ${i + 1}`}>
            <PostCard post={post} index={i} />
          </li>
        ))}
      </ol>
    ) : (
      <p style="color: var(--fg-secondary)">No posts yet.</p>
    )
  }
  {
    posts.length > 0 && (
      <nav class="browse reveal" style={`--i: ${posts.length + 1}`} aria-label="Browse">
        {hasMore && (
          <a href={withBase('archive/')}>Archive →</a>
        )}
        <a href={withBase('tags/')}>Tags →</a>
      </nav>
    )
  }
</BaseLayout>

<style>
  /* Frame and Pip both in --accent, the burnished gold of the wordmark's
     full stop — the dot Pip grew from. */
  .welcome {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--s-lg);
    margin: var(--s-md) 0 var(--s-2xl);
    padding: var(--s-lg) var(--s-lg) var(--s-lg) var(--s-xl);
    border: 1px solid var(--accent);
    border-radius: var(--radius-md);
  }
  /* The title cut into the top border, like a TUI box: `╭─── title ───╮`. */
  .welcome__legend {
    position: absolute;
    top: 0;
    left: var(--s-lg);
    transform: translateY(-50%);
    margin: 0;
    padding-inline: var(--s-sm);
    background: var(--bg);
    font-family: var(--font-mono);
    font-size: var(--t-label-md-size);
    font-weight: 700;
    line-height: 1;
    color: var(--fg);
    word-spacing: normal;
  }
  /* Pip a size down in the panel so the box stays compact: 15px keeps
     whole-pixel 9px cells, 19px rows under 19.8px glyphs. */
  .welcome :global(.pip) {
    font-size: 0.9375rem;
    line-height: 1.1875rem;
  }
  /* 1rem × 1.625 = 26px lines — reads level beside Pip. */
  .welcome__title {
    margin: 0;
    max-width: 44ch;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.625;
    letter-spacing: -0.01em;
    word-spacing: normal;
    color: var(--fg);
    text-wrap: balance;
  }
  @media (max-width: 480px) {
    .welcome {
      gap: var(--s-md);
      padding: var(--s-lg) var(--s-md) var(--s-md);
    }
    .welcome__title {
      font-size: 0.9375rem;
    }
  }
  /* Too narrow to sit side by side: Pip over the tagline. */
  @media (max-width: 360px) {
    .welcome {
      grid-template-columns: 1fr;
    }
  }

  .browse {
    display: flex;
    gap: var(--s-lg, 2rem);
    margin-top: var(--s-xl, 3rem);
    padding-top: var(--s-md, 1rem);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }
  .browse a {
    color: var(--accent);
    text-decoration: none;
  }
  .browse a:hover {
    color: var(--accent-bright);
  }
</style>
