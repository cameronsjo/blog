---
import { SITE_WORDMARK } from '../consts';
import { withBase } from '../utils';

const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { href: withBase(''), label: 'Home' },
  { href: withBase('about'), label: 'About' },
  { href: withBase('search'), label: 'Search' },
];
---

{/* Non-sticky on purpose: a reading site's header scrolls away with the page
    (cameronsjo/artificer-design-system#131 → the editorial .masthead). The one
    piece of chrome that stays put is the 3px top rule in ReadingProgress. */}
<header class="site-header">
  <a
    href={withBase('')}
    class="wordmark wordmark--stop-none whimsy whimsy--brand font-mono text-lg font-bold"
    data-wordmark
  >
    {SITE_WORDMARK}
  </a>
  <nav class="site-nav" aria-label="Site">
    {
      nav.map((item) => {
        const active = path === item.href.replace(/\/$/, '');
        return (
          <a href={item.href} aria-current={active ? 'page' : undefined}>
            {item.label}
          </a>
        );
      })
    }
    <button
      type="button"
      class="theme-toggle theme-toggle--inline font-mono"
      data-theme-toggle
      aria-label="Toggle color theme"
    >
      <span class="dot" aria-hidden="true"></span>
      <span data-theme-label>Dark</span>
    </button>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-md);
    padding-block: var(--s-lg) var(--s-md);
    border-bottom: 1px solid var(--border);
  }

  /* ── Nav — the masthead treatment (artificer-editorial's .masthead__nav,
     which this site doesn't import): secondary ink, fg on hover, accent + a
     2px underline band on the current page so "you are here" never rides on
     color alone. ──────────────────────────────────────────────────────────── */
  .site-nav {
    display: flex;
    align-items: center;
    gap: var(--s-lg);
    font-size: var(--t-label-md-size);
  }
  .site-nav a {
    color: var(--fg-secondary);
    text-decoration: none;
    padding-block: var(--s-xs);
    transition: color var(--dur-fast) var(--ease);
  }
  @media (hover: hover) {
    .site-nav a:hover {
      color: var(--fg);
    }
  }
  .site-nav a[aria-current='page'] {
    color: var(--accent);
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  /* 44px nav targets on touch (a11y #8). */
  @media (pointer: coarse) {
    .site-nav a,
    .wordmark {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      min-width: 44px;
    }
  }
  @media (max-width: 480px) {
    .site-nav {
      gap: var(--s-md);
    }
  }
  /* Narrow phones: tighten the row and drop the toggle to its dot so the
     header never outgrows a 320px viewport. The label stays in the
     accessibility tree; the button keeps its aria-label either way. */
  @media (max-width: 400px) {
    .site-header,
    .site-nav {
      gap: var(--s-sm);
    }
    .theme-toggle {
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
    }
    .theme-toggle [data-theme-label] {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--s-xs);
    padding: var(--s-xs) var(--s-sm);
    font-size: var(--t-label-sm-size);
    color: var(--fg-secondary);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      border-color var(--dur-fast) var(--ease),
      color var(--dur-fast) var(--ease);
  }
  .theme-toggle:hover {
    color: var(--fg);
    border-color: var(--accent);
  }
  .theme-toggle .dot {
    width: var(--s-sm);
    height: var(--s-sm);
    border-radius: 50%;
    background: var(--accent);
  }
</style>
