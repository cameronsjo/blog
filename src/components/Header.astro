---
import { SITE_WORDMARK } from '../consts';
import { withBase } from '../utils';

const path = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { href: withBase(''), label: 'Home' },
  { href: withBase('about'), label: 'About' },
  { href: withBase('search'), label: 'Search' },
];
---

<header
  class="flex items-center justify-between gap-4 border-b py-5"
  style="border-color: var(--border)"
>
  <a
    href={withBase('')}
    class="wordmark wordmark--stop-none whimsy whimsy--brand font-mono text-lg font-bold"
    data-wordmark
  >
    {SITE_WORDMARK}
  </a>
  <nav class="flex items-center gap-5 text-sm">
    {
      nav.map((item) => {
        const active = path === item.href.replace(/\/$/, '');
        return (
          <a class="nav-link" href={item.href} aria-current={active ? 'page' : undefined}>
            {item.label}
          </a>
        );
      })
    }
    {/* Canonical Artificer toggle, the same one the root site uses:
        @cameronsjo/artificer/theme.js injects the glyph and runs the
        dark → light → auto cycle. */}
    <button
      type="button"
      class="theme-toggle theme-toggle--inline"
      data-theme-toggle
      aria-label="Toggle theme"
    ></button>
  </nav>
</header>

<style>
  .nav-link {
    color: var(--fg-secondary);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease);
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--fg);
  }
  .nav-link[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35em;
  }
</style>
