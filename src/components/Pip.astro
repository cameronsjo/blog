---
// Pip — Artificer's critter. A burnished seed with a sprout: the gold full stop
// from `artificer.` that took root and grew feet (a pip is both a dot and a
// seed). Drawn as real text in quadrant block characters, so it renders in
// JetBrains Mono (block glyphs come from the unicode-range subset declared in
// global.css) and copy-pastes into a terminal intact.
//
// Colored --accent — the same burnished gold as the wordmark's full stop. Hover
// a `.pip-host` ancestor (or Pip) and it hops once — a state change, not a loop.
//
// `helmet` puts Pip under glass for space: a second text layer, stacked on the
// same grid cell, draws a stepped bell jar over the seedling whose base crosses
// just above the feet. Two layers because one character cell holds one color.
interface Props {
  class?: string;
  helmet?: boolean;
}

const { class: className, helmet = false } = Astro.props;

// 18×10 px, 2×2 px per glyph. Sprout (leaf + stem), round body, two dot eyes,
// two feet.
const PIP = ['   ▗▟▀', '   ▄▙▄', ' ▗█▜█▛█▖', ' ███████', ' ▝▜▛▀▜▛▘'];
// Suited: one blank row above for the dome, one column in for the walls. The
// blank row is a space, not '': HTML drops a newline right after <pre>, which
// would pull the body up a row out from under the jar.
const BODY = helmet ? [' ', ...PIP.map((row) => ` ${row}`)] : PIP;
const HELMET = [
  '  ╭─────╮',
  ' ╭╯     ╰╮',
  '╭╯       ╰╮',
  '│         │',
  '│         │',
  '╰─────────╯',
];

const label = helmet
  ? 'Pip, a seedling critter, under a glass space helmet, drawn in block characters'
  : 'Pip, a seedling critter, drawn in block characters';
---

<div class:list={['pip', className]} role="img" aria-label={label}>
  <pre class="pip__layer pip__body">{BODY.join('\n')}</pre>
  {helmet && <pre class="pip__layer pip__helmet">{HELMET.join('\n')}</pre>}
</div>

<style>
  .pip {
    display: inline-grid;
    /* 20px → 12px cells and 6px quadrants: whole pixels, so adjacent glyphs
       meet without anti-aliased seams. The block glyphs are 1.32em tall
       (26.4px); a whole-pixel 26px line pitch overlaps rows by a hair. A
       fractional pitch lets baseline snapping alternate 19/20px and open a
       hairline between rows, so both sizes pin line-height to whole pixels. */
    font-size: 1.25rem;
    line-height: 1.625rem;
  }
  .pip__layer {
    grid-area: 1 / 1;
    margin: 0;
    padding: 0;
    overflow: visible;
    background: none;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: inherit;
    line-height: inherit;
    /* The page's body letter/word spacing would pry the glyphs apart. */
    letter-spacing: 0;
    word-spacing: normal;
    font-kerning: none;
    font-variant-ligatures: none;
    /* Where two glyphs' anti-aliased edges meet, their partial coverages don't
       add up to a solid pixel, leaving hairline seams (worst on light ground).
       A same-color stroke this thin swells each glyph just past the seam. */
    -webkit-text-stroke: 0.03em currentColor;
  }
  .pip__body {
    color: var(--accent);
  }
  /* Later in the grid cell, so it paints over the body: the jar's base reads as
     a rim across Pip, not a line behind. Box-drawing glyphs already overlap
     their neighbors by design, so the seam stroke only beads their joins. */
  .pip__helmet {
    color: var(--fg-secondary);
    -webkit-text-stroke: 0;
  }

  @keyframes pip-hop {
    0%,
    100% {
      transform: none;
    }
    45% {
      transform: translateY(-0.35em);
    }
  }
  .pip:hover,
  :global(.pip-host:hover) .pip {
    animation: pip-hop var(--dur-max) var(--ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .pip:hover,
    :global(.pip-host:hover) .pip {
      animation: none;
    }
  }

  /* Phones: 15px keeps whole-pixel 9px cells; 19px rows under 19.8px glyphs. */
  @media (max-width: 480px) {
    .pip {
      font-size: 0.9375rem;
      line-height: 1.1875rem;
    }
  }
</style>
