---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;
// h2/h3 only — h1 is the post title, h4+ is too granular for a sidebar TOC.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  toc.length > 1 && (
    <nav class="toc not-prose" aria-label="Table of contents">
      <p class="toc__label eyebrow">On this page</p>
      <ul class="toc__list">
        {toc.map((h) => (
          <li class:list={['toc__item', { 'toc__item--sub': h.depth === 3 }]}>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  /* Hairline-ruled block, not a raised card with a left stripe (an
     Artificer anti-pattern). The label is Artificer's .eyebrow. */
  .toc {
    margin-bottom: var(--s-xl);
    padding: var(--s-md) 0;
    border-block: 1px solid var(--border);
  }
  .toc__label {
    margin: 0 0 var(--s-sm);
  }
  .toc__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .toc__item {
    line-height: 1.5;
  }
  .toc__item--sub {
    padding-left: var(--s-md);
  }
  .toc__item a {
    color: var(--fg-secondary);
    text-decoration: none;
    font-size: 0.85rem;
    transition: color var(--dur-fast) var(--ease);
  }
  .toc__item a:hover {
    color: var(--accent);
  }
</style>
