---
// The brand top-rule — a gold → purple hairline pinned to the viewport top
// (Cameron's signature pairing). On posts it doubles as a reading-progress bar
// that fills as the article scrolls past; everywhere else it stays a full,
// static rule. The page marks what counts as "the read" with
// [data-progress-target].
interface Props {
  progress?: boolean;
}

const { progress = false } = Astro.props;
---

<div class="topline" data-progress={progress ? '' : undefined} aria-hidden="true">
  <span class="topline__fill"></span>
</div>

<script>
  // Progress runs 0→1 across the article, written to --progress on the fill.
  // Article-relative, not document-relative, so the footer doesn't count toward
  // "read". rAF-throttled; the fill maps straight to scroll position with no
  // transition — it tracks the reader's own input like a scrollbar, so there's
  // nothing for reduced-motion to suppress.
  //
  // This module runs once; View Transitions swap <body>, so the element refs
  // are re-read on every astro:page-load (which also fires on first load).
  let fill: HTMLElement | null = null;
  let article: HTMLElement | null = null;
  let queued = false;

  function update() {
    queued = false;
    if (!fill || !article) return;
    const rect = article.getBoundingClientRect();
    const span = rect.height - window.innerHeight;
    // Article shorter than the viewport: it's "read" once its end is on screen.
    const raw = span > 0 ? -rect.top / span : rect.bottom <= window.innerHeight ? 1 : 0;
    fill.style.setProperty('--progress', String(Math.min(1, Math.max(0, raw))));
  }

  function schedule() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(update);
  }

  document.addEventListener('astro:page-load', () => {
    fill = document.querySelector<HTMLElement>('.topline[data-progress] .topline__fill');
    article = fill ? document.querySelector<HTMLElement>('[data-progress-target]') : null;
    update();
  });
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule, { passive: true });
</script>

<style>
  /* The fill is clipped, not scaled, so the gradient stays pinned to the
     viewport: early in a post you see gold, and purple arrives at the end. */
  .topline {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-raised);
    height: 2px;
    pointer-events: none;
  }
  .topline__fill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--brand-purple));
    clip-path: inset(0 calc((1 - var(--progress, 1)) * 100%) 0 0);
  }
  .topline[data-progress] {
    height: 3px;
    background: var(--border);
  }
  .topline[data-progress] .topline__fill {
    --progress: 0;
    /* A soft purple bloom under the filled run; negative vertical insets keep
       the clip from cutting it off. */
    box-shadow: 0 0 var(--s-sm) color-mix(in oklch, var(--brand-purple) 55%, transparent);
    clip-path: inset(
      calc(-1 * var(--s-sm)) calc((1 - var(--progress)) * 100%) calc(-1 * var(--s-sm)) 0
    );
  }
</style>
