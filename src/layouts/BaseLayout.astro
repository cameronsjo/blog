---
import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@cameronsjo/artificer/artificer.css';
import '@cameronsjo/artificer/whimsy.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  ogImage?: string;
  tags?: string[];
}

const { title, description, pubDate, updatedDate, ogImage, tags } = Astro.props;

// Cloudflare Web Analytics — cookieless manual beacon. One CF site/token for
// cameronsjo.github.io covers the root, /blog, and /agentic-harnesses (CF Web
// Analytics aggregates by hostname). Token is public/write-only; no SRI hash
// because Cloudflare serves beacon.min.js mutable/unversioned with no published
// hash — an `integrity` pin would break on their next update.
const CF_BEACON_TOKEN = '9db7302de886402680e0838d0f35f7db';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      pubDate={pubDate}
      updatedDate={updatedDate}
      ogImage={ogImage}
      tags={tags}
    />
    <ClientRouter />
    {/* Theme: applied pre-paint (no FOUC), shared with the rest of the
        Artificer system via the `artificer.theme` localStorage key. Same
        bootstrap as the root site: it ONLY sets the initial data-theme before
        first paint (default dark on a first visit, else the pinned mode, with
        'auto' resolved against the OS). Binding the toggle (glyph,
        aria-label, the dark → light → auto cycle, live OS tracking in auto)
        is @cameronsjo/artificer/theme.js's job, loaded below.

        A first visit WRITES 'dark' to the key: theme.js reads a missing key
        as 'auto', so without the write a light-OS visitor paints dark and
        then flips to light when theme.js binds. Theme carry-over across
        view transitions is handled in the module script below. */}
    <script is:inline>
      (function () {
        var KEY = 'artificer.theme';
        var stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch (e) {}
        // Missing key: first visit, pin dark. Unrecognised value: 'auto',
        // the same reading theme.js's storedMode() gives it.
        var mode =
          stored === null
            ? 'dark'
            : stored === 'dark' || stored === 'light' || stored === 'auto'
              ? stored
              : 'auto';
        if (stored === null) {
          try {
            localStorage.setItem(KEY, mode);
          } catch (e) {}
        }
        var theme =
          mode === 'auto'
            ? window.matchMedia &&
              window.matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark'
            : mode;
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
    <script>
      import '@cameronsjo/artificer/theme.js';
      // View Transitions replace <html>'s attributes with the incoming
      // document's, and the server-rendered <html> has no data-theme. Carry
      // the live theme onto the new document before the swap, or every link
      // click paints the default theme until theme.js rebinds.
      document.addEventListener('astro:before-swap', (e) => {
        const theme = document.documentElement.getAttribute('data-theme');
        if (theme) e.newDocument.documentElement.setAttribute('data-theme', theme);
      });
      // The swap also replaces <body>, so the toggle arrives unbound and
      // theme.js's MutationObserver is still watching the old body. Rebind
      // after every swap; bind() skips buttons it already bound.
      document.addEventListener('astro:page-load', () => {
        window.ArtificerTheme?.bind();
      });
    </script>
  </head>
  <body>
    <div class="topline" aria-hidden="true"></div>
    <div class="shell mx-auto flex min-h-screen max-w-2xl flex-col px-5">
      <Header />
      <main class="flex-1 py-10">
        <slot />
      </main>
      <Footer />
    </div>
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon={`{"token":"${CF_BEACON_TOKEN}"}`}
    />
    <script>
      // Seasonal footer greeting (artificer-whimsy). Sets window.Whimsy and
      // swaps [data-whimsy-greeting]: June → "happy pride" (vivid per-char flow,
      // the one line that never settles); off-season → the footer's own inline
      // line + glacial drift. Graceful without JS (plain inline text).
      //
      // whimsy.js is a side-effect-only module (exports nothing; just assigns
      // window.Whimsy), and the package marks JS side-effect-free
      // (sideEffects: ["*.css"]) — so a *static* `import` gets tree-shaken away
      // and the feature silently dies. A dynamic import is never shaken: load it
      // once, cache window.Whimsy, then re-apply after every View-Transitions
      // swap (astro:page-load fires on initial load too; greeting() is
      // idempotent per element via its done-flag guard).
      document.addEventListener('astro:page-load', async () => {
        if (!window.Whimsy) await import('@cameronsjo/artificer/whimsy.js');
        window.Whimsy?.greeting();
      });
    </script>
  </body>
</html>
